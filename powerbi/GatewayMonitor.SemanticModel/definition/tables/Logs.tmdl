/// Gateway log records loaded into the model (gold.logTypes).
table Logs
	lineageTag: 82dec248-9403-44c4-a7f3-a765d766780a
	sourceLineageTag: [gold].[logs]

	measure '# Logs' = COUNTROWS('Logs')
		formatString: #,0
		lineageTag: ee08c3f2-c94b-4d13-8b4a-eb33597cd639

	measure '# Files' = DISTINCTCOUNT('Logs'[LogFileName])
		formatString: 0
		lineageTag: 2318bbad-f61c-42d8-ae08-104193f1f271

	measure '# Gateways (Logs)' = DISTINCTCOUNT('Logs'[GatewayId])
		formatString: 0
		lineageTag: a1cb7376-bc1e-44d0-84ad-cdc5fedc4711

	measure 'Logs (k)' = DIVIDE('Logs'[# Logs], 1000, "")
		lineageTag: a6ffb57e-fa06-45e1-9033-761de4c5e7a3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Logs (Errors)' = CALCULATE([# Logs], 'Logs'[Level] = "Error")
		formatString: #,0
		lineageTag: 8491a584-9436-4ada-bc97-6786a3cb066c

	measure '# Logs (NonErrors)' = CALCULATE([# Logs], 'Logs'[Level] <> "Error")
		formatString: #,0
		lineageTag: b7e1426d-1b68-4c42-b574-db47ff39a2e3

	column ActivityId
		dataType: string
		lineageTag: b0e48156-53fb-4dd8-b3fd-60a44c70ef1f
		sourceLineageTag: activity_id
		summarizeBy: none
		sourceColumn: activity_id

		annotation SummarizationSetBy = Automatic

