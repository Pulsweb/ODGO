/// Gateway queries (start ⟕ execution).
table Queries
	lineageTag: 6cdef62f-7a83-46c6-b49f-2ddb0b891db9
	sourceLineageTag: [gold].[queries]

	measure '# Queries' = ```
			COUNTROWS('Queries')
			
			```
		formatString: #,0
		lineageTag: 2eed33be-ae02-4ad8-85fa-a5b8ea6fb4ef

	/// Time difference in ms from the QueryStart and QueryEnd
	measure 'Query Avg. Execution (ms)' = ```
			
			AVERAGE('Queries'[TotalQueryExecution(ms)])
			/*AVERAGEX('Gateway Queries', 
			[QueryExecutionDuration(ms)] 
			+ [DataProcessingDuration(ms)] 
			// + [DataReadingAndSerializationDuration(ms)] 
			// + [SpoolingDiskReadingDuration(ms)] 
			// + [SpoolingDiskWritingDuration(ms)]
			)*/
			```
		formatString: #,0
		lineageTag: 58674b3c-3e06-4bb4-8313-4941e778a941

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Query Avg. Execution - DirectQuery (ms)' = CALCULATE([Query Avg. Execution (ms)], KEEPFILTERS('Queries'[QueryType] = "DirectQuery"))
		formatString: #,0
		lineageTag: c430801b-064a-48de-aa65-e0aaba26d10e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Query Avg. Execution - Refresh (ms)' = CALCULATE('Queries'[Query Avg. Execution (ms)], KEEPFILTERS('Queries'[QueryType] = "Refresh"))
		formatString: #,0
		lineageTag: 04a183f2-cc8a-47a8-9d9c-2c03afee31b6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Success formatting' = IF(FIRSTNONBLANK('Queries'[Success],0)="Y", 1,0)
		formatString: 0
		lineageTag: 7d928ea6-bc82-4b67-b482-cc4a9de7c9ac

	measure 'Disk Read Avg. (byte/sec)' = AVERAGEX('Queries', DIVIDE([SpoolingTotalDataSize(byte)] , [SpoolingDiskReadingDuration(ms)] / 1000))
		formatString: #,0
		lineageTag: 4baee74e-1b66-417a-92db-8754e1b0af9f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Disk Write Avg. (byte/sec)' = AVERAGEX('Queries', DIVIDE([SpoolingTotalDataSize(byte)] , [SpoolingDiskWritingDuration(ms)] / 1000))
		formatString: #,0
		lineageTag: 61b0e8d9-0f80-4b70-96d8-db1c3c2515ec

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '# Requests (Queries)' = DISTINCTCOUNT('Queries'[RequestId])
		formatString: #,0
		lineageTag: bd169a94-ba75-490e-8033-e7f77b54b55b

	measure '# Queries (Refresh)' = CALCULATE([# Queries], KEEPFILTERS('Queries'[QueryType] = "Refresh"))
		formatString: #,0
		lineageTag: 0e4dcf96-9c35-466e-96c5-09bd1e98ff9a

	measure '# Queries (DirectQuery)' = CALCULATE([# Queries], KEEPFILTERS('Queries'[QueryType] = "DirectQuery"))
		formatString: #,0
		lineageTag: 40da288c-c4a1-4459-9bf7-aa9d9a49b70c

	measure '# Gateways (Queries)' = DISTINCTCOUNT('Queries'[GatewayId])
		formatString: 0
		lineageTag: 563a4c9b-6a0e-4776-9d01-639f6c069b63

	measure '# Queries - Concurrent' = ```
			
			 var rangeStart = MIN('Calendar'[Date]) + SWITCH(TRUE(), ISINSCOPE('Time'[Minute]), MIN('Time'[Minute]), ISINSCOPE('Time'[Quarter Hour]), MIN('Time'[Quarter Hour]), ISINSCOPE('Time'[Half Hour]), MIN('Time'[Half Hour]), ISINSCOPE('Time'[Hour]), MIN('Time'[Hour]))
			 var gatewayCount = COUNTROWS(VALUES('Queries'[GatewayId]))
			
			return IF(gatewayCount > 1, error("Please filter a gateway, this measure don't work with multiple gateways selected"), 
			CALCULATE([# Queries], 
			FILTER(
			ADDCOLUMNS(
			    //ALLEXCEPT('Gateway Queries', 'Gateway Queries'[DataSource Kind], 'Gateway Queries'[Success], 'Gateway Queries'[QueryType])
			    CALCULATETABLE('Queries', ALL('Time'))
			    , "Start Datetime", [Start Date] + [Start Time], "End Datetime", [End Date] + [End Time])
			, 
			[Start Datetime] <= rangeStart && [End Datetime] > rangeStart)
			)
			
			// var queriesInPeriod = FILTER(ALL('Gateway Queries'), 
			//      var queryStart = [Start Datetime]
			//      var queryEnd = [End Datetime]
			//     // var queryStart = [Date] + [Time]
			//     // var queryEnd = [End Date] + [End Time]
			//     return 
			//         queryStart <> BLANK() && queryEnd <> BLANK() &&
			
			//         queryStart <= rangeStart && queryEnd > rangeStart
			//        // queryStart <= rangeStart && queryEnd > rangeStart
			//         )
			
			// //var queriesInPeriod = FILTER(ALL('Gateway Queries'), 'Gateway Queries'[Start Datetime] >= rangeStart && 'Gateway Queries'[End Datetime] > rangeEnd)
			    
			// return  COUNTROWS(queriesInPeriod)//MAXX(queriesInPeriod, [End Datetime]) //
			/*
			SUMX('Gateway Queries'
			, 
			    var queryStart = [Date] + [Time]
			    var queryEnd = [End Date] + [End Time]
			
			    return IF(queryStart = BLANK() || queryEnd = BLANK(), 0, IF(queryStart >= rangeStart && queryEnd > rangeEnd, 1, BLANK()))
			)
			*/)
			```
		formatString: 0
		lineageTag: eebc2978-9b42-4193-94e5-890bacfe2725

	measure '# Queries - Concurrent (DirectQuery)' = CALCULATE([# Queries - Concurrent], 'Queries'[QueryType] = "DirectQuery")
		formatString: 0
		lineageTag: 842727d3-879a-4a7c-ad45-f8a7a2c4d2b9

	measure '# Queries - Concurrent (Refresh)' = CALCULATE([# Queries - Concurrent], 'Queries'[QueryType] = "Refresh")
		formatString: 0
		lineageTag: 743685fd-cf1f-4094-823b-49a97477ee5c

	measure '# Queries (Errors)' = CALCULATE([# Queries], 'Queries'[Success] = "N")
		formatString: #,0
		lineageTag: 5f837e3f-6c97-4e4f-9f6d-c4e646e63922

