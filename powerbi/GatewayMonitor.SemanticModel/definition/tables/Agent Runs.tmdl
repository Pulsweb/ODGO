/// Collection agent runs (heartbeats) (new ingestion metric).
table 'Agent Runs'
	lineageTag: e4865a6a-aeb2-5463-8a3e-da94b1fcee2a
	sourceLineageTag: [gold].[ingestion_agent_runs]

	/// Collection agent runs (heartbeats).
	measure '# Agent Runs' = COUNTROWS('Agent Runs')
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 2b8a617f-c3e8-59a5-adde-987db69a6add

	/// Agent runs that failed.
	measure '# Failed Agent Runs' = COALESCE(CALCULATE(COUNTROWS('Agent Runs'), 'Agent Runs'[Status] = "Failed"), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: ed1c1ad6-f2bb-5c1e-96dd-526e2e7d65cb

	/// Share of agent runs that succeeded.
	measure 'Agent Run Success Rate' = DIVIDE(CALCULATE(COUNTROWS('Agent Runs'), 'Agent Runs'[Status] = "Succeeded"), [# Agent Runs])
		formatString: 0.0%
		displayFolder: Ingestion Health
		lineageTag: 70f64bba-58c5-5ddd-9a46-d72f78ddb681

	column 'Run Id'
		dataType: string
		lineageTag: 7ada5740-ae34-5f7f-80d4-ee54a8a78eab
		sourceLineageTag: run_id
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

