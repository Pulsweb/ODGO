model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation GatewayMonitor_Source = Migrated from github.com/RuiRomano/pbigtwmonitor (MIT)

ref table Calendar
ref table Time
ref table Gateways
ref table Logs
ref table LogsArtifactTrace
ref table Queries
ref table 'Queries - Datasources'
ref table Requests
ref table 'Mashup Logs'
ref table 'Mashup Container Profile'
ref table 'System Counters'
ref table Servers
ref table 'Ingestion Uploads'
ref table 'Agent Runs'
ref table 'Processing Runs'
ref table 'Ingestion Issues'
ref table 'Param - Counters Axis'
ref table 'Param - Counters Measure'

