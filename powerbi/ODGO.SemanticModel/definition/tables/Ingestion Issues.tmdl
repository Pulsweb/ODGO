/// Quarantined files, rejected records, missing segments, failures and schema drift (new).
table 'Ingestion Issues'
	lineageTag: d2d848c9-6d94-56bc-b834-dc9ea40f928c
	sourceLineageTag: [gold].[ingestion_issues]

	/// Ingestion issues (quarantine, rejected records, missing segments, failures, schema drift).
	measure '# Issues' = COUNTROWS('Ingestion Issues')
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: a59364da-c408-5422-903f-a8431cf0a832

	/// Files moved to processing/quarantine (invalid manifest, checksum mismatch, binary content...).
	measure '# Quarantined Files' = COALESCE(CALCULATE(COUNTROWS('Ingestion Issues'), 'Ingestion Issues'[Issue Type] = "Quarantined File"), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: e7529d1f-c2b9-5577-a570-970324f06ee8

	/// Records that could not be parsed or typed (kept in ops.rejected_records).
	measure '# Rejected Records' = COALESCE(CALCULATE(SUM('Ingestion Issues'[Occurrences]), 'Ingestion Issues'[Issue Type] = "Rejected Record"), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 9c510aa6-90dc-588c-8e0f-4d07cfcead1a

	/// Segments listed in a manifest whose raw file was not found.
	measure '# Missing Segments' = COALESCE(CALCULATE(COUNTROWS('Ingestion Issues'), 'Ingestion Issues'[Issue Type] = "Missing Segment"), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 27b74d5d-8bd1-5a15-ae7e-3395417c660d

	column 'Issue Id'
		dataType: string
		lineageTag: f6ac8f04-d881-52d9-8f8c-c16088fbb920
		sourceLineageTag: issue_id
		summarizeBy: none
		sourceColumn: issue_id

		annotation SummarizationSetBy = Automatic

	column 'Issue Type'
