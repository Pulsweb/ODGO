/// Mashup engine events.
table 'Mashup Logs'
	lineageTag: 6825ddf4-45f4-4cc1-98d9-cc9a9dc05f3e
	sourceLineageTag: [gold].[mashup_logs]

	measure 'Max Pool (Pending)' = MAX('Mashup Logs'[pendingCount])
		formatString: 0
		lineageTag: 03d9ec11-624f-477f-874f-570f22f074e9

	measure 'Max Pool (Running)' = MAX('Mashup Logs'[runningCount])
		formatString: 0
		lineageTag: e5bed470-4de2-4444-ae40-6d455132565b

	measure 'Avg. Mashup Duration (ms)' = AVERAGE('Mashup Logs'[Duration (ms)])
		formatString: #,0.0
		lineageTag: df7fa3a7-add2-4bd4-8e8e-80d18e5cef0d

	measure '# Mashup Logs' = COUNTROWS('Mashup Logs')
		formatString: #,0
		lineageTag: 2cb089ea-7306-4588-aacb-8abba26ca8f5

	measure '# Mashup Errors' = CALCULATE([# Mashup Logs], 'Mashup Logs'[Error (Y/N)] = "Y")
		formatString: #,0
		lineageTag: 98ed963e-9ccc-497b-9ec3-89c030d2106b

	measure '# Mashup Queries' = DISTINCTCOUNTNOBLANK('Mashup Logs'[CommandText])
		formatString: 0
		lineageTag: 6bca4e06-9dcc-49f1-a10c-0187c7935943

	measure '# Mashup Containers' = DISTINCTCOUNTNOBLANK('Mashup Logs'[ContainerID])
		formatString: 0
		lineageTag: 4d5aad8c-d439-489d-ad2a-cc37cf1af549

