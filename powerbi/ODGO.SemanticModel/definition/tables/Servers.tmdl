/// Collection agents / servers with their latest status (new ingestion metric).
table Servers
	lineageTag: 7f90227b-41ee-5217-8b6f-b9d2afc55161
	sourceLineageTag: [gold].[ingestion_servers]

	/// Servers (collection agents) that reported at least one run.
	measure '# Servers' = COUNTROWS('Servers')
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 80c9b4d5-1395-5f09-b90d-163a1e7e7523

	/// Minutes since the most recent agent run (heartbeat) in the current filter context.
	measure 'Minutes Since Last Heartbeat' =
			VAR lastRun = MAX('Servers'[Last Agent Run (UTC)])
			RETURN IF(NOT ISBLANK(lastRun), DATEDIFF(lastRun, UTCNOW(), MINUTE))
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 58eedc2a-3ce9-5a7a-a792-33fc3b8e1a3a

	/// Minutes since the most recent uploaded segment in the current filter context.
	measure 'Minutes Since Last Upload' =
			VAR lastUpload = MAX('Servers'[Last Upload (UTC)])
			RETURN IF(NOT ISBLANK(lastUpload), DATEDIFF(lastUpload, UTCNOW(), MINUTE))
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 5172a949-8c7b-55f2-825b-16a7fab87079

	/// OK, Late, Missing (no heartbeat within Late After / Missing After minutes) or Failing (last run failed). One server only.
	measure 'Upload Status' =
			IF(
			    HASONEVALUE('Servers'[ServerId]),
			    VAR minutes = [Minutes Since Last Heartbeat]
			    VAR lateAfter = MAX('Servers'[Late After (min)])
			    VAR missingAfter = MAX('Servers'[Missing After (min)])
			    VAR lastStatus = MAX('Servers'[Last Run Status])
			    RETURN
			        SWITCH(
			            TRUE(),
			            ISBLANK(minutes) || minutes > missingAfter, "Missing",
			            minutes > lateAfter, "Late",
			            lastStatus = "Failed", "Failing",
			            "OK"
			        )
			)
		displayFolder: Ingestion Health
		lineageTag: 6cb76f0e-d8cf-52ae-933a-d400d5f43068

	/// Hex color of Upload Status (conditional formatting).
	measure 'Upload Status Color' = SWITCH([Upload Status], "OK", "#107C10", "Late", "#C19C00", "Failing", "#D13438", "Missing", "#D13438")
		displayFolder: Ingestion Health
		lineageTag: b61d4ff2-1331-51da-8734-a12ee219060e

	/// Servers without a heartbeat for more than Missing After minutes.
	measure '# Servers (Missing Uploads)' = COALESCE(COUNTROWS(FILTER(VALUES('Servers'[ServerId]), [Upload Status] = "Missing")), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: afccd563-7d59-52f0-af19-ac5786690403

	/// Servers whose last heartbeat is older than Late After minutes.
	measure '# Servers (Late)' = COALESCE(COUNTROWS(FILTER(VALUES('Servers'[ServerId]), [Upload Status] = "Late")), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: f9a2ac11-db40-5ea1-8a99-9fb9bfff0704

	/// Servers whose last agent run failed.
	measure '# Servers (Failing)' = COALESCE(COUNTROWS(FILTER(VALUES('Servers'[ServerId]), [Upload Status] = "Failing")), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 8b442423-e260-5fa5-a115-10b2b4724e38

	/// Most recent segment upload.
	measure 'Latest Upload (UTC)' = MAX('Servers'[Last Upload (UTC)])
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Ingestion Health
		lineageTag: b48a1827-c6f1-50c3-bb9b-af952397f5d9

	/// Most recent processing of an uploaded segment.
	measure 'Latest Processing (UTC)' = MAX('Servers'[Last Processed (UTC)])
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Ingestion Health
		lineageTag: 7c0545c3-1b3f-5104-96e7-36b3ef57146e

	/// Source file of the most recently processed segment.
	measure 'Latest Processed File' =
			MAXX(
			    TOPN(1, FILTER('Servers', NOT ISBLANK('Servers'[Last Processed (UTC)])), 'Servers'[Last Processed (UTC)], DESC),
			    'Servers'[Last Processed File]
			)
		displayFolder: Ingestion Health
		lineageTag: 2a6fe96d-0de6-5163-87ac-14815a07605b

	/// Distinct collection agent versions in use.
	measure '# Agent Versions' = DISTINCTCOUNTNOBLANK('Servers'[Agent Version])
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 474ba474-5847-506e-aeb6-511873263a89

	column ServerId
