/// Uploaded segments and their processing status (new ingestion metric).
table 'Ingestion Uploads'
	lineageTag: b009109b-169f-518f-8849-7fa798e78bb7
	sourceLineageTag: [gold].[ingestion_uploads]

	/// Segments uploaded by the agents (ingestion window).
	measure '# Uploaded Segments' = COUNTROWS('Ingestion Uploads')
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 7108dcd0-cac0-5cfd-8db7-6f6403500b63

	/// Uploaded volume in MB.
	measure 'Uploaded MB' = DIVIDE(SUM('Ingestion Uploads'[Bytes]), 1048576)
		formatString: #,0.0
		displayFolder: Ingestion Health
		lineageTag: f7920fd5-0ac8-5c12-b628-b4f9bd62528b

	/// Records parsed from the uploaded segments.
	measure '# Records Ingested' = SUM('Ingestion Uploads'[Records])
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 87c9bf8a-9e9f-5d5e-9f7c-ce32b3ff0cd9

	/// Uploaded segments awaiting processing (Pending) or not found yet (Missing).
	measure '# Pending Segments' = COALESCE(CALCULATE(COUNTROWS('Ingestion Uploads'), 'Ingestion Uploads'[Status] IN {"Pending", "Missing"}), 0)
		formatString: #,0
		displayFolder: Ingestion Health
		lineageTag: 35f604bd-e636-5e7e-9766-ec2f72eaafb0

	/// Average minutes between the last write of the source file and processing.
	measure 'Avg. Ingestion Latency (min)' = AVERAGE('Ingestion Uploads'[Ingestion Latency (min)])
		formatString: #,0.0
		displayFolder: Ingestion Health
		lineageTag: 3bd1c959-8dd6-5e9b-a4a0-ea12a8fe816c

	/// Maximum minutes between the last write of the source file and processing.
	measure 'Max Ingestion Latency (min)' = MAX('Ingestion Uploads'[Ingestion Latency (min)])
		formatString: #,0.0
		displayFolder: Ingestion Health
		lineageTag: 817e0158-c3a8-5e62-98db-1dd243e6ad57

